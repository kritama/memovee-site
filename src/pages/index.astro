---
import Layout from '../layouts/Layout.astro';
---

<Layout title="memovee — the computer that remembers you">
  <div class="flex flex-1 flex-col items-center justify-center gap-10 px-6 text-center">
    <h1>
      <span class="sr-only">memovee</span>
      <pre aria-hidden="true" class="pixel-logo">█   █ █████ █   █  ███  █   █ █████ █████
██ ██ █     ██ ██ █   █ █   █ █     █
█ █ █ █     █ █ █ █   █ █   █ █     █
█   █ ████  █   █ █   █ █   █ ████  ████
█   █ █     █   █ █   █ █   █ █     █
█   █ █     █   █ █   █  █ █  █     █
█   █ █████ █   █  ███    █   █████ █████</pre>
    </h1>
    <div class="flex flex-col items-center gap-4">
      <p class="text-balance text-lg font-light tracking-[0.025em] text-base-content/65 sm:text-2xl">
        the computer that <span class="tagline-emphasis">remembers you</span>
      </p>
      <p class="flex items-center gap-2.5 font-mono text-[0.68rem] uppercase tracking-[0.16em] text-base-content/45 sm:text-xs">
        <span aria-hidden="true" class="status-mark"></span>
        <span>coming soon to an omarchy near you</span>
      </p>
    </div>
  </div>
</Layout>

<style>
  .pixel-logo {
    margin: 0;
    overflow: visible;
    color: var(--color-primary);
    background-image: linear-gradient(
      165deg,
      var(--color-primary),
      var(--color-secondary) 50%,
      var(--color-accent)
    );
    background-clip: text;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: clamp(0.53rem, 2.15vw, 1.25rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: 0.04em;
    text-align: left;
    user-select: none;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .tagline-emphasis {
    color: var(--color-secondary);
    background-image: linear-gradient(120deg, var(--color-secondary), var(--color-accent));
    background-clip: text;
    font-weight: 600;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .status-mark {
    width: 0.45rem;
    height: 0.45rem;
    flex: none;
    background: var(--color-accent);
    box-shadow: 0 0 0.7rem color-mix(in oklab, var(--color-accent) 75%, transparent);
  }
</style>
