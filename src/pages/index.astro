---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Memovee" description="Memovee — built for developers.">
  <section class="hero bg-base-200">
    <div class="hero-content text-center">
      <div class="max-w-2xl">
        <h1 class="text-5xl font-bold">Memovee</h1>
        <p class="py-6 text-lg">
          Build, ship, and scale developer experiences on the edge.
        </p>
        <div class="flex justify-center gap-3">
          <a href="/docs" class="btn btn-primary">Read the docs</a>
          <a href="#get-started" class="btn btn-outline">Get started</a>
        </div>
      </div>
    </div>
  </section>

  <section id="get-started" class="grid gap-6 py-12 md:grid-cols-3">
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title font-mono text-base">Astro</h2>
        <p>Static-first site generation with island architecture where you need it.</p>
      </div>
    </div>
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title font-mono text-base">Tailwind + daisyUI</h2>
        <p>Utility-first styling with ready-made, themeable UI components.</p>
      </div>
    </div>
    <div class="card bg-base-100 shadow">
      <div class="card-body">
        <h2 class="card-title font-mono text-base">Cloudflare Workers</h2>
        <p>Global edge deployment with Wrangler for one-command releases.</p>
      </div>
    </div>
  </section>
</Layout>
